# ── build output ─────────────────────────────────────────────────────────────
public/
.quartz-cache/
node_modules/
tsconfig.tsbuildinfo
prof/
.DS_Store

# ── vault safety ─────────────────────────────────────────────────────────────
# The Obsidian vault lives outside this repo and must stay there. These entries
# are belt-and-braces for the case where someone copies vault folders in by
# hand: the real protection is scripts/check-private-paths.mjs, which refuses
# to publish anything that did not come from the vault's Public/ tree with
# `publish: true`. Names here mirror the vault's private folders exactly.
00-inbox/
10-projects/
20-career/
30-knowledge/
40-results/
50-lessons/
90-archive/
_templates/
.obsidian/
private/

# Anything a human parks in the repo while drafting.
drafts/
*.private.md

# ── migration ────────────────────────────────────────────────────────────────
# Fetched HTML from the one-shot inblog migration (~4 MB). Useful to keep
# locally so the script can be re-run without touching the network; no reason
# to ship it.
.migration-cache/

# NOTE: content/ IS tracked. It is generated by `pnpm blog:sync`, but the
# deploy builds from the committed tree, so it has to be in git. Never edit it
# by hand — the guard will reject anything in content/ without a Public/
# counterpart.
